# Copy to .env.local for local overrides. Never commit .env.local.
# In Vercel: Project Settings -> Environment Variables.

# Deployed backend URL (Render/Railway/etc). Used by BOTH the REST client and
# the Socket.IO client — they must point at the same origin, or the session
# cookie won't be shared with the websocket. Defaults to localhost if unset.
VITE_API_URL=http://localhost:1643
