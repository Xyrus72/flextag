# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/flextag)
MONGO_URI=

# Port the API listens on
PORT=1643

# Long random string used to sign session cookies
SESSION_SECRET=

# development | production
NODE_ENV=development

# ── Deployment (Vercel/Render/Railway) ────────────────────────────────────────
# Comma-separated deployed frontend origin(s) allowed to call this API and open
# a Socket.IO connection — e.g. https://flextag.vercel.app. Localhost is always
# allowed for local dev regardless of this setting. Leave blank for local-only.
ALLOWED_ORIGINS=

# ── Email (OTP) ──────────────────────────────────────────────────────────────
# Gmail address that sends OTP emails
EMAIL_USER=
# Gmail App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_PASS=

# ── Admin provisioning (used by `npm run seed` / createAdmin.js) ──────────────
ADMIN_EMAIL=admin@flextag.com
# Leave blank to have a strong password generated and printed once
ADMIN_PASSWORD=

# ── Instagram intelligence (creator audits + automated post verification) ─────
# Data provider: hiker | session | auto (auto = HikerAPI when a key is set, else session)
IG_PROVIDER=auto
# RECOMMENDED: HikerAPI (https://hikerapi.com) — pay-per-request (~$0.0006), scrapes
# from its own IP pool so audits don't depend on this server's IP reputation.
HIKERAPI_KEY=
# FALLBACK: a DEDICATED throwaway Instagram account's cookies — never a personal
# one. Log in to instagram.com with it, open DevTools -> Application -> Cookies ->
# instagram.com and copy these three values. Per-IP rate limits apply.
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
# Optional tuning (admin-editable in Settings; these are only the fallbacks)
IG_REQUEST_INTERVAL_MS=1500
IG_MIN_FOLLOWERS=1000
IG_AUDIT_TTL_DAYS=7
IG_FOLLOWER_SAMPLE=200
IG_POSTS_TO_FETCH=30
# enforce = block ineligible creators at signup · advisory = allow but flag for admin
IG_PRECHECK_MODE=enforce
# Fraud guard: max reward (৳/order) for creators without a bio-verified Instagram
# (0 = no cap; silver/gold tiers multiply it; admin-editable in Settings)
IG_UNVERIFIED_REWARD_CAP=500

# ── SSLCommerz payment gateway (free sandbox creds at developer.sslcommerz.com) ──
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:1643

# ── AI (Anthropic) for captions + caption validator ─────────────────────────
ANTHROPIC_API_KEY=

# ── Optional: official Instagram Graph API (Business Discovery) provider ──────
# Zero ban risk but public Business/Creator accounts only, no follower sampling.
# Needs a Meta app + FlexTag's own IG Business account + long-lived token.
# Set IG_PROVIDER=graph to make it primary (HikerAPI stays the fallback).
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=

# ── Creator payouts (services/payouts) ───────────────────────────────────────
# How money actually leaves FlexTag: manual | http | bkash.
#   manual  (default) an admin sends it from their own bKash/Nagad app and
#           confirms it in /admin/payouts — the queue, ledger, receipts and
#           notifications work identically either way.
#   http    POST to any aggregator/middleware you already have (see below)
#   bkash   bKash tokenized disbursement (needs a merchant contract)
# A half-configured automatic provider falls back to manual, so nobody's payout
# gets stuck behind a missing credential.
PAYOUT_PROVIDER=manual
# Smallest withdrawal a creator can request (admin-editable in Settings; this is
# only the fallback).
MIN_WITHDRAWAL=500
# Send queued payouts on a schedule instead of a button. Ignored unless the
# provider is an automatic one — a "manual" auto-runner would mark money paid
# that nobody actually sent.
PAYOUT_AUTO=0
PAYOUT_AUTO_INTERVAL_MIN=15
PAYOUT_AUTO_BATCH=20
# provider=http: we POST { amount, account, method, reference } and read back
# { status: 'paid'|'processing'|'failed', reference?, message? }
PAYOUT_API_URL=
PAYOUT_API_TOKEN=
PAYOUT_API_HEADERS=
# provider=bkash: your merchant's own base URL, credentials and paths. Sandbox
# and production differ — check the paths against YOUR contract before going live.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_TOKEN_PATH=/tokenized/checkout/token/grant
BKASH_DISBURSE_PATH=/tokenized/checkout/payout/create

# ── "Connect Instagram" — per-creator OAuth (services/instagram/connect) ─────
# Facebook Login for Business. Proves account ownership continuously and is the
# ONLY way to verify stories (they vanish in 24h and no scraper can see them).
# Leave blank and the endpoints return 503 — the bio-code path stays the way
# creators verify, so nothing breaks.
IG_APP_ID=
IG_APP_SECRET=
# Must be listed as a Valid OAuth Redirect URI in the Meta app. Defaults to
# <BACKEND_URL>/api/instagram/connect/callback.
IG_OAUTH_REDIRECT=
IG_GRAPH_VERSION=v21.0

# ── Email digest (services/email, jobs/digestJobs) ───────────────────────────
# Money and dispute events email as they happen; everything else rolls into one
# evening digest. No-op without EMAIL_USER / EMAIL_PASS above.
DIGEST_HOUR=19
DIGEST_OFF=0

# ── Background jobs ──────────────────────────────────────────────────────────
# Dispute SLA: hours a brand has to reply before it escalates to the admin queue.
DISPUTE_SLA_HOURS=48
# Cashback % that counts as "unusually high" for a wishlist alert.
WISHLIST_HOT_RATE=50
# Set to off to disable the dispute SLA / wishlist / rating-nudge jobs.
MARKETPLACE_JOBS=on
# Set to off to disable Instagram retention checks, re-audits and token refresh.
IG_JOBS=on

# ── Error tracking (utils/errorReporting) ────────────────────────────────────
# Opt-in. Without a DSN nothing is sent anywhere — local dev and CI never phone
# home. Credential-shaped fields are scrubbed before any report leaves.
SENTRY_DSN=
SENTRY_TRACES_RATE=0
SENTRY_RELEASE=

# ── Social share cards (services/ogImage) ────────────────────────────────────
# resvg rasterises the 1200x630 card using system fonts. A bare Linux container
# has none, which renders the card with invisible text — point this at a .ttf
# (or install fonts-dejavu) on such hosts. Without it we serve the SVG instead
# of a broken image.
OG_FONT_PATH=

# ── Referrals ────────────────────────────────────────────────────────────────
# One-time bonus paid to BOTH sides when a referred creator completes their
# first campaign.
REFERRAL_BONUS=100
