# Copy to .env and fill in real values. Never commit .env.

# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/flextag)
MONGO_URI=

# Port the API listens on
PORT=1643

# Long random string used to sign session cookies
SESSION_SECRET=

# development | production
NODE_ENV=development

# ── Email (OTP) ──────────────────────────────────────────────────────────────
# Gmail address that sends OTP emails
EMAIL_USER=
# Gmail App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_PASS=

# ── Admin provisioning (used by `npm run seed` / createAdmin.js) ──────────────
ADMIN_EMAIL=admin@flextag.com
# Leave blank to have a strong password generated and printed once
ADMIN_PASSWORD=

# ── Instagram intelligence (creator audits + automated post verification) ─────
# Data provider: hiker | session | auto (auto = HikerAPI when a key is set, else session)
IG_PROVIDER=auto
# RECOMMENDED: HikerAPI (https://hikerapi.com) — pay-per-request (~$0.0006), scrapes
# from its own IP pool so audits don't depend on this server's IP reputation.
HIKERAPI_KEY=
# FALLBACK: a DEDICATED throwaway Instagram account's cookies — never a personal
# one. Log in to instagram.com with it, open DevTools -> Application -> Cookies ->
# instagram.com and copy these three values. Per-IP rate limits apply.
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
# Optional tuning (admin-editable in Settings; these are only the fallbacks)
IG_REQUEST_INTERVAL_MS=1500
IG_MIN_FOLLOWERS=1000
IG_AUDIT_TTL_DAYS=7
IG_FOLLOWER_SAMPLE=200
IG_POSTS_TO_FETCH=30
# enforce = block ineligible creators at signup · advisory = allow but flag for admin
IG_PRECHECK_MODE=enforce
# Fraud guard: max reward (৳/order) for creators without a bio-verified Instagram
# (0 = no cap; silver/gold tiers multiply it; admin-editable in Settings)
IG_UNVERIFIED_REWARD_CAP=500

# ── SSLCommerz payment gateway (free sandbox creds at developer.sslcommerz.com) ──
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:1643

# ── AI (Anthropic) for captions + caption validator ─────────────────────────
ANTHROPIC_API_KEY=

# ── Optional: official Instagram Graph API (Business Discovery) provider ──────
# Zero ban risk but public Business/Creator accounts only, no follower sampling.
# Needs a Meta app + FlexTag's own IG Business account + long-lived token.
# Set IG_PROVIDER=graph to make it primary (HikerAPI stays the fallback).
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=
